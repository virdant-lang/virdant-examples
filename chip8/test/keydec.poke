# UART keypad decoder poke testbench (top::Top).
# 115200 8N1 at 50 MHz: 434 ticks per bit; only `tick` clocks the design
# (`advance` moves time without clocking).
# Keystrokes are ASCII on the classic CHIP-8 layout:
#   1 2 3 4 -> 1 2 3 C;  Q W E R -> 4 5 6 D;
#   A S D F -> 7 8 9 E;  Z X C V -> A 0 B F.
# 'W'=key5, 'V'=keyF, '3'=key3; '5' (0x35) is not a key character.
print core.keypad.key
# establish idle-high
poke rx true
