    }

    mod cell_5_3 of LifeCell {
        it.clock := clock
        it.reset := reset
        it.north := cell_5_2.state
        it.south := cell_5_4.state
        it.west := cell_4_3.state
        it.east := cell_6_3.state
        it.northwest := cell_4_2.state
        it.northeast := cell_6_2.state
        it.southwest := cell_4_4.state
