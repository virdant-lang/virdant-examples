    }

    mod cell_4_3 of LifeCell {
        it.clock := clock
        it.reset := reset
        it.north := cell_4_2.state
        it.south := cell_4_4.state
        it.west := cell_3_3.state
        it.east := cell_5_3.state
        it.northwest := cell_3_2.state
        it.northeast := cell_5_2.state
        it.southwest := cell_3_4.state
        it.southeast := cell_5_4.state
        it.advance := advance
        it.load_seed := randomize
