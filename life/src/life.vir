    }

    mod cell_6_3 of LifeCell {
        it.clock := clock
        it.reset := reset
        it.north := cell_6_2.state
        it.south := cell_6_4.state
        it.west := cell_5_3.state
        it.east := cell_7_3.state
        it.northwest := cell_5_2.state
        it.northeast := cell_7_2.state
        it.southwest := cell_5_4.state
        it.southeast := cell_7_4.state
        it.advance := advance
        it.load_seed := randomize
        it.seed_bit := lfsr[30]
    }

    mod cell_7_3 of LifeCell {
        it.clock := clock
        it.reset := reset
        it.north := cell_7_2.state
        it.south := cell_7_4.state
        it.west := cell_6_3.state
        it.east := east_in[3]
        it.northwest := cell_6_2.state
        it.northeast := east_in[2]
        it.southwest := cell_6_4.state
        it.southeast := east_in[4]
        it.advance := advance
        it.load_seed := randomize
        it.seed_bit := lfsr[31]
    }

    mod cell_0_4 of LifeCell {
        it.clock := clock
        it.reset := reset
        it.north := cell_0_3.state
        it.south := cell_0_5.state
        it.west := west_in[4]
        it.east := cell_1_4.state
        it.northwest := west_in[3]
        it.northeast := cell_1_3.state
