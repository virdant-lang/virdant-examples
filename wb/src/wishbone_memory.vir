socket Wishbone {
    cosi cyc : Bit
    cosi stb : Bit
    cosi we : Bit
    cosi addr : Word[32]
    cosi wr_data : Word[32]

    soci ack : Bit
    soci rd_data : Word[32]
}

ext mod Memory {
    incoming clock : Clock
    incoming we : Bit
    incoming addr : Word[32]
    incoming wr_data : Word[32]
    outgoing rd_data : Word[32]
}

mod WishboneMemory {
    incoming clock : Clock

    server socket wishbone of Wishbone {
        it.ack := ack
        it.rd_data := memory.rd_data
    }

    reg ack : Bit on clock {
        it <= wishbone.cyc && wishbone.stb
    }

    mod memory of Memory {
        it.clock := clock
        it.we := wishbone.cyc && wishbone.stb && wishbone.we
        it.addr := wishbone.addr
        it.wr_data := wishbone.wr_data
    }
}
