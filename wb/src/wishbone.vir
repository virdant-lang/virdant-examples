//! Wishbone bus socket.
//!
//! Shared by every Wishbone slave in this project.

//> Wishbone classic bus socket.
//>
//> A 32-bit data bus with 32-bit byte addresses.
//> All channels are from the client's (master's) perspective.
socket Wishbone {
    cosi cyc : Bit
    cosi stb : Bit
    cosi we : Bit
    cosi addr : Word[32]
    cosi wr_data : Word[32]

    soci ack : Bit
    soci rd_data : Word[32]
}
